**/.angular/

# ==========================================
# Environment Variables & Secrets (Never commit!)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# ==========================================
# IDE & Editor Configurations
